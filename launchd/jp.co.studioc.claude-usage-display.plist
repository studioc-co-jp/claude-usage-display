<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  claude-usage-display を、ログインしたときに起動し、止まったら起動し直す。
  利用枠の画面（run）とサーバーの状態の画面（monitor）で、このひな形を共用する（ラベルとコマンドを差し替える）。

  ひな形はリポジトリの launchd/ にある。~/Library/LaunchAgents/ の同名ファイルは、
  scripts/install-launch-agent.sh が @…@ の部分をこの Mac のパスに置き換えて作る
  （launchd は ~ を展開しないため、絶対パスを埋める必要がある）。
  配置したほうを直接編集しない。登録し直すと上書きされる。

  登録:  scripts/install-launch-agent.sh [run のオプション]
         scripts/install-launch-agent.sh --monitor [monitor のオプション]（ラベルは末尾に .monitor）
  解除:  scripts/uninstall-launch-agent.sh [--monitor]
  状態:  launchctl print gui/$(id -u)/jp.co.studioc.claude-usage-display
  ログ:  ~/Library/Logs/claude-usage-display.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>-m</string>
    <string>claude_usage_display</string>
    <string>@COMMAND@</string>
    <!-- @RUN_OPTIONS@ -->
  </array>

  <!-- python -m はカレントディレクトリからパッケージを探す。 -->
  <key>WorkingDirectory</key>
  <string>@ROOT@</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- run は SIGTERM を受けるまで終わらない。落ちたときは launchd が起動し直す。
       ディスプレイが無いあいだ、run は 10 秒ごとに接続を確かめるだけで API を呼ばない。 -->
  <key>KeepAlive</key>
  <true/>

  <!-- launchd は LANG・LC_ALL を渡さない。Python は C ロケールでは UTF-8 モードに自動で入るが
       （2026-10-05 に launchd 経由で sys.flags.utf8_mode = 1 を確認）、ロケールに頼らず明示する。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUTF8</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
